<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.SecurityPatrol" parent="Theme.Material3.Light.NoActionBar">
        <item name="colorPrimary">@color/brand_primary</item>
        <item name="colorOnPrimary">@color/white</item>
        <item name="colorPrimaryContainer">@color/brand_primary_dark</item>
        <item name="colorSecondary">@color/brand_accent</item>
        <item name="colorOnSecondary">@color/white</item>
        <item name="android:statusBarColor">@color/brand_primary_dark</item>
        <item name="android:windowBackground">@color/bg</item>
    </style>

    <style name="ChipStatus" parent="Widget.Material3.Button.TextButton">
        <item name="android:textSize">11sp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">2dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="backgroundTint">@color/chip_completed_bg</item>
        <item name="android:textColor">@color/chip_completed_fg</item>
        <item name="cornerRadius">14dp</item>
        <item name="android:minHeight">0dp</item>
    </style>
</resources>
