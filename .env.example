# ============================================================
# .env untuk docker compose (security-patrol)
# Salin ke .env lalu isi password kuat:
#   cp .env.example .env
# (docker compose otomatis membaca .env di folder ini)
# ============================================================

# Port web (http://localhost:8080)
APP_PORT=8080

# URL publik aplikasi (dipakai Laravel utk generate link)
APP_URL=http://localhost:8080

# --- Database ---
DB_DATABASE=security_patrol
DB_USERNAME=patrol
DB_PASSWORD=GANTI_PASSWORD_DB_KUAT
DB_ROOT_PASSWORD=GANTI_PASSWORD_ROOT_KUAT

# --- Laravel APP_KEY ---
# Kosongkan utk generate otomatis (disimpan di volume, persist antar restart).
# Boleh juga isi manual hasil dari: php artisan key:generate --show
APP_KEY=
